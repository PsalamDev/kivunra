# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
# Same value as PAYPAL_CLIENT_ID. Exposed to the browser to load the JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Groq
GROQ_API_KEY=
# Optional: override the default model (llama-3.3-70b-versatile)
GROQ_MODEL=

# Public invoice links
# Random, stable secret (min 32 chars). Rotating it invalidates every pay link.
# Generate one with: openssl rand -hex 32
INVOICE_TOKEN_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
# Verified sender, e.g. Kivunra <invoices@yourdomain.com>
INVOICE_EMAIL_FROM=
# Optional: override the Resend API base URL (local mock/testing only)
RESEND_API_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
