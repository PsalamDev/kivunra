# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
# Same value as PAYPAL_CLIENT_ID. Exposed to the browser to load the JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Groq
GROQ_API_KEY=
# Optional: override the default model (llama-3.3-70b-versatile)
GROQ_MODEL=
# Optional: override the Groq API base URL (local mock/testing only)
GROQ_API_URL=

# Public invoice links
# Random, stable secret (min 32 chars). Rotating it invalidates every pay link.
# Generate one with: openssl rand -hex 32
INVOICE_TOKEN_SECRET=

# Transactional email
# brevo | resend. Optional: when unset, the provider with a key is used
# (Brevo wins if both are set).
EMAIL_PROVIDER=
# Brevo: verify a single sender address at Brevo -> Senders, then use it as
# INVOICE_EMAIL_FROM. No domain/DNS is required (recommended for deliverability).
BREVO_API_KEY=
# Optional: override the Brevo API base URL (local mock/testing only)
BREVO_API_URL=
# Resend: onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=
# Optional: override the Resend API base URL (local mock/testing only)
RESEND_API_URL=
# Verified sender for the active provider, e.g. Kivunra <invoices@yourdomain.com>
INVOICE_EMAIL_FROM=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron
# Vercel sends this as a Bearer token to /api/cron/mark-overdue. Required for
# the daily overdue sweep; list views also mark overdue invoices on read.
CRON_SECRET=
